{
  "$schema": "https://modelcontextprotocol.io/schemas/server-card-v1.json",
  "name": "devdeskapp-docs",
  "displayName": "DevDeskApp Docs MCP Server",
  "description": "Documentation search, node operation definitions, and workflow blueprint lookup for DevDeskApp.",
  "version": "1.0.0",
  "homepage": "https://docs.devdeskapp.com",
  "repository": "https://github.com/DevdeskApp/devdeskapp-docs",
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": false
  },
  "transport": {
    "type": "stdio"
  },
  "tools": [
    {
      "name": "search_docs",
      "description": "Searches DevDeskApp and n8n community node documentation topics.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Documentation search query" }
        },
        "required": ["query"]
      }
    },
    {
      "name": "get_node_operation_schema",
      "description": "Returns parameter specifications and examples for any DevDeskApp n8n operation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "jsonPrettifier",
              "hashGenerator",
              "ctcCalculator",
              "slugGenerator",
              "base64Converter",
              "urlEncoder",
              "uuidGenerator",
              "caseConverter",
              "markdownToHtml",
              "jwtDecoder"
            ],
            "description": "Operation identifier"
          }
        },
        "required": ["operation"]
      }
    },
    {
      "name": "get_workflow_template",
      "description": "Retrieves copy-paste ready n8n workflow JSON blueprints for DevDeskApp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "enum": ["21017", "21130"],
            "description": "Official n8n template ID"
          }
        },
        "required": ["templateId"]
      }
    }
  ]
}
